    {
      "parameters": {
        "jsCode": "// التحقق من وجود body (POST request فقط)\nif (!$json.body) {\n  console.log('⚠️ No body found - probably GET request');\n  return [];\n}\n\nconst body = $json.body;\n\n// التحقق من صحة البيانات\nif (!body?.entry?.[0]?.changes?.[0]?.value?.id) {\n  console.log('❌ No valid comment data');\n  return [];\n}\n\n// استخراج بيانات الكومنت\nconst commentId = body.entry[0].changes[0].value.id;\nconst commentText = body.entry[0].changes[0].value.text;\nconst fromUser = body.entry[0].changes[0].value.from;\n\n// إدارة التكرار باستخدام Workflow Static Data\nconst store = $getWorkflowStaticData('global');\nstore.processedComments = store.processedComments || {};\n\nconst now = Date.now();\nconst ttl = 30 * 60 * 1000; // 30 دقيقة (زيادة الوقت للأمان)\n\n// تنظيف السجلات القديمة (أكثر من 30 دقيقة)\nObject.keys(store.processedComments).forEach(id => {\n  if (now - store.processedComments[id] > ttl) {\n    delete store.processedComments[id];\n  }\n});\n\n// فحص إذا تم معالجة الكومنت من قبل\nif (store.processedComments[commentId]) {\n  const secondsAgo = Math.floor((now - store.processedComments[commentId]) / 1000);\n  console.log(`🛑 DUPLICATE DETECTED! Comment ${commentId} was processed ${secondsAgo}s ago - STOPPING`);\n  return [];\n}\n\n// تسجيل الكومنت كمعالج\nstore.processedComments[commentId] = now;\nconsole.log(`✅ Processing NEW comment ${commentId}`);\nconsole.log(`   Text: \"${commentText}\" | From: @${fromUser.username}`);\n\n// إرجاع البيانات المنسقة\nreturn [{\n  json: {\n    comment_id: commentId,\n    text: commentText,\n    from: fromUser,\n    timestamp: body.entry[0].time,\n    orig_body: body\n  }\n}];\n"
      },
